# Catalog release assets: built by `npm run catalog:generate` and uploaded to the
# GitHub Release. Only the DIGEST (src/catalog-digest.ts) is committed, so the
# integrity anchor is the npm artifact and the tagged tree, not these files.
catalog-index.json
catalog-*.json.gz
